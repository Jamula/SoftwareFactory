{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamula.github.io/SoftwareFactory/engineering-coordinator.schema.json",
  "title": "Engineering Coordinator project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "execution", "limits", "adapters", "lanes"],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "repositorySlug": {"type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "repoRelativePath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "not": {"pattern": "(^/|//|/$|(^|/)\\.{1,2}(/|$))"}
    },
    "specialistRole": {
      "enum": ["api", "data", "security", "test", "infra", "ui", "docs", "coordinator"]
    },
    "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "repository", "defaultBranch"],
      "properties": {
        "key": {"$ref": "#/$defs/identifier"},
        "repository": {"$ref": "#/$defs/repositorySlug"},
        "defaultBranch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "not": {"pattern": "(\\.\\.|//|/$)"}, "maxLength": 120}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "mode", "stop"],
      "properties": {
        "enabled": {"type": "boolean"}, "mode": {"const": "shadow"}, "stop": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxConcurrentLanes", "leaseMs", "maxAttempts", "baseDelayMs", "maxDelayMs"],
      "properties": {
        "maxConcurrentLanes": {"type": "integer", "minimum": 1, "maximum": 12},
        "leaseMs": {"type": "integer", "minimum": 1000, "maximum": 3600000},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "baseDelayMs": {"type": "integer", "minimum": 1, "maximum": 60000},
        "maxDelayMs": {"type": "integer", "minimum": 1, "maximum": 300000}
      }
    },
    "adapters": {
      "type": "object", "additionalProperties": false,
      "required": ["workTracker", "engineeringAgent", "state"],
      "properties": {
        "workTracker": {"enum": ["injected-read-only", "mock"]},
        "engineeringAgent": {"enum": ["injected-read-only", "mock"]},
        "state": {"const": "sqlite"}
      }
    },
    "lanes": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "owners", "prompt"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "specialist": {"$ref": "#/$defs/specialistRole"},
          "owners": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/repoRelativePath"}},
          "prompt": {"$ref": "#/$defs/repoRelativePath"}
        }
      }
    },
    "knowledgeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "source", "generatedAtMs", "maxAgeMs", "components"],
      "properties": {
        "repository": {"$ref": "#/$defs/repositorySlug"},
        "revision": {"$ref": "#/$defs/commitSha"},
        "source": {"const": "trusted-default-branch"},
        "generatedAtMs": {"type": "integer", "minimum": 0},
        "maxAgeMs": {"type": "integer", "minimum": 1000, "maximum": 604800000},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "lane", "specialist", "owners", "interfaces", "decisions", "tests", "dependsOn"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "lane": {"$ref": "#/$defs/identifier"},
              "specialist": {"$ref": "#/$defs/specialistRole"},
              "owners": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/repoRelativePath"}},
              "interfaces": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/repoRelativePath"}},
              "decisions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/repoRelativePath"}},
              "tests": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/repoRelativePath"}},
              "dependsOn": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
            }
          }
        }
      }
    }
  },
  "if": {
    "type": "object",
    "required": ["project"],
    "properties": {
      "project": {
        "type": "object",
        "required": ["repository"],
        "properties": {
          "repository": {"pattern": "^[Jj][Aa][Mm][Uu][Ll][Aa]/[Ss][Oo][Ff][Tt][Ww][Aa][Rr][Ee][Ff][Aa][Cc][Tt][Oo][Rr][Yy]$"}
        }
      }
    }
  },
  "else": {
    "properties": {
      "limits": {
        "properties": {
          "maxConcurrentLanes": {"maximum": 8}
        }
      }
    }
  }
}
